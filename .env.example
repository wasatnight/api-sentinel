# Copy to .env locally. Never commit .env or real credentials.
SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel_app@127.0.0.1:55434/api_sentinel_review
# Set a generated password through your process environment (recommended).
SENTINEL_DB_PASSWORD=
# Windows helper sets this locally; leave blank on Linux/WSL.
SENTINEL_DB_PASSWORD_FILE=
SENTINEL_ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
SENTINEL_MONITORING_ENABLED=false
SENTINEL_CHECK_CONCURRENCY=4
